{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ramsaijanapana/claudey/schemas/project-release-manifest.schema.json",
  "title": "Claudey project release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "managerVersion", "sourceRevision", "managerShimCompatibilityVersion", "payload", "shims", "targets", "sbom", "provenanceSubjects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "managerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceRevision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "managerShimCompatibilityVersion": { "type": "integer", "minimum": 1 },
    "payload": { "$ref": "#/$defs/artifact" },
    "shims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x64", "windows-arm64"],
      "properties": {
        "windows-x64": { "$ref": "#/$defs/shim" },
        "windows-arm64": { "$ref": "#/$defs/shim" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x64", "windows-arm64", "darwin-x64", "darwin-arm64", "linux-x64", "linux-arm64"],
      "properties": {
        "windows-x64": { "$ref": "#/$defs/windowsTarget" },
        "windows-arm64": { "$ref": "#/$defs/windowsTarget" },
        "darwin-x64": { "$ref": "#/$defs/posixTarget" },
        "darwin-arm64": { "$ref": "#/$defs/posixTarget" },
        "linux-x64": { "$ref": "#/$defs/posixTarget" },
        "linux-arm64": { "$ref": "#/$defs/posixTarget" }
      }
    },
    "sbom": { "$ref": "#/$defs/artifact" },
    "provenanceSubjects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "flags"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "flags": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "shim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size", "compiler"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "compiler": { "$ref": "#/$defs/compiler" }
      }
    },
    "windowsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "shim"],
      "properties": {
        "payload": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "shim": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" }
      }
    },
    "posixTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "shim"],
      "properties": {
        "payload": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "shim": { "type": "null" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
